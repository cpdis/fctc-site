---
// Gold marquee strip. Decorative (aria-hidden); pauses on hover.
// `reverse` flips the travel direction for the closing band. `name` lets the
// date takeovers (src/scripts/eggs/dates.ts) find and retitle a band.
interface Props {
  text: string;
  name: string;
  reverse?: boolean;
}

const { text, name, reverse = false } = Astro.props;

// two identical spans; the track slides -50% for a seamless loop
const content = `${text} • `.repeat(6);
---

<div class:list={["marquee", { reverse }]} data-marquee={name} aria-hidden="true">
  <div class="track">
    <span>{content}</span>
    <span>{content}</span>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--gold);
    color: var(--espresso);
    border-block: 2px solid var(--espresso);
    padding: 10px 0;
  }
  .track {
    display: flex;
    width: max-content;
    animation: slide var(--marquee-dur) linear infinite;
  }
  .marquee.reverse .track {
    animation-direction: reverse;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .marquee span {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.2em;
    white-space: nowrap;
  }
  /* Cold Brew Neon mode: the gold band becomes a gold tube */
  :global(html.neon) .marquee {
    background: transparent;
    color: var(--gold);
    border-color: var(--gold);
    text-shadow: 0 0 6px rgba(255, 210, 63, 0.8);
    box-shadow: 0 0 14px rgba(255, 210, 63, 0.35), inset 0 0 14px rgba(255, 210, 63, 0.2);
  }
  @keyframes slide {
    to { transform: translateX(-50%); }
  }
</style>
